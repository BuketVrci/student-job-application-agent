# Copy this file to .env and fill in real values. Never commit .env.

# --- General ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL (used by the postgres service and the backend) ---
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=jobagent
POSTGRES_DB=job_application_agent
# Host is the docker-compose service name; only change if you rename the service.
DATABASE_URL=postgresql+asyncpg://jobagent:jobagent@postgres:5432/job_application_agent

# --- Auth (generate a real secret for production, e.g. `openssl rand -hex 32`) ---
JWT_SECRET_KEY=change-me-dev-only-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- LLM provider (provider-agnostic; default is free local Ollama) ---
# One of: ollama | openai | anthropic | gemini
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Job source connectors ---
# Arbeitnow is a public API and needs no key.
# Adzuna requires a free developer account: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
